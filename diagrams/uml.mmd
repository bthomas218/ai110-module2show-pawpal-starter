classDiagram
    class Task {
        +TaskId id
        +str description
        +time time
        +str frequency
        +bool completion_status
        +mark_complete()
        +is_complete() bool
    }

    class Pet {
        +PetId id
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(Task)
        +remove_task(Task)
    }

    class Owner {
        +OwnerId id
        +str name
        +str email
        +list~Pet~ pets
        +add_pet(Pet)
        +remove_pet(Pet)
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +build_schedule(Owner) list~Task~
        +complete_task(Owner, TaskId) bool
        +render_schedule(Owner) str
    }

    Owner "1" *-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : owns
    Scheduler ..> Owner : reads all tasks from
    Scheduler ..> Task : organizes
